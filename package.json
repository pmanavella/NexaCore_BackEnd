{
  "name": "nexacore-backend",
  "version": "1.0.0",
  "description": "Backend API para NexaCore — Sistema de gestión integral",
  "main": "index.js",
  "scripts": {
    "start": "NODE_ENV=production node index.js",
    "dev": "cross-env NODE_ENV=development nodemon index.js",
    "test": "node --test",
    "test:coverage": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-include=\"finance/**/*.js\" --test-coverage-exclude=\"finance/**/deudas*.js\" --test-coverage-exclude=\"finance/services/migradores/comprasInternacionales.js\" --test-coverage-exclude=\"finance/services/migradores/cuentasPorCobrar.js\" --test-coverage-exclude=\"finance/services/migradores/totalesFinancieros.js\" --test-coverage-exclude=\"finance/services/migradores/sueldosHistoricos.js\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pdfkit": "0.17.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.0.2"
  }
}
