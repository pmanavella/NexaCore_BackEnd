# NexaCore — Variables de entorno del Backend
# Copiar este archivo como .env y completar los valores reales

# Puerto del servidor Express
PORT=3001

# Etiqueta legible de la base de datos, solo para el log de arranque
DB_LABEL=nexacore_db

# Supabase (Project URL y Service Role Key — NO exponer en cliente)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key-aqui

# CORS — Orígenes permitidos, separados por coma
# Desarrollo: http://localhost:5173
# Producción: https://tu-dominio-real.com
ALLOWED_ORIGINS=http://localhost:5173

# Gemini para análisis estructurado de comprobantes (nunca exponer en frontend)
GEMINI_API_KEY=tu-gemini-api-key

# Nexi (asistente) — opcional. Modelo de Gemini para el chat; usa la misma
# GEMINI_API_KEY. Por defecto: gemini-3.1-flash-lite
# NEXI_GEMINI_MODEL=gemini-3.1-flash-lite
# Tiempo total máximo de una consulta a Nexi (modelo + herramientas), en ms.
# Por defecto: 60000
# NEXI_TIMEOUT_TOTAL_MS=60000
# Timeout de cada intento de llamada a Gemini, en ms. Si un intento lo supera,
# se reintenta UNA vez solo si quedan al menos 5 s del límite total.
# Por defecto: 15000
# NEXI_PROVIDER_TIMEOUT_MS=15000

# CUIT de la empresa sin guiones. Define automáticamente ingreso vs gasto.
COMPANY_CUIT=30123456789
